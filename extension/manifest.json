{
    "manifest_version": 3,
    "name": "Michigan Food Finder — Menu Relay",
    "version": "1.1.0",
    "description": "Relays UMich dining menus from your browser to your Michigan Food Finder database.",
    "permissions": ["alarms", "offscreen", "storage", "notifications"],
    "host_permissions": ["https://dining.umich.edu/*"],
    "background": { "service_worker": "background.js" },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Menu Relay"
    }
}
